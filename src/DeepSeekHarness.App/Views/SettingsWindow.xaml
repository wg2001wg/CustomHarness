<Window x:Class="DeepSeekHarness.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="640" Width="960"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BgLayer2}" FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{StaticResource BgLayer1}" BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,1,0">
            <ListBox x:Name="NavList" Style="{StaticResource NavList}" Margin="10"
                     SelectedValuePath="Tag"
                     SelectedValue="{Binding SelectedTab, Mode=TwoWay}">
                <ListBoxItem Content="⚙  Models(模型)" Tag="Models" />
                <ListBoxItem Content="🧩  Agent presets(预设)" Tag="Presets" />
                <ListBoxItem Content="🔌  Plugins(插件)" Tag="Plugins" />
                <ListBoxItem Content="📁  General(常规)" Tag="General" />
            </ListBox>
        </Border>

        <!-- 右侧内容 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
            <!-- ===== Models ===== -->
            <StackPanel x:Name="ModelsPanel" Visibility="{Binding SelectedTab, Converter={StaticResource TabIsModelsConv}, ConverterParameter=Models}">
                <TextBlock Text="模型提供商" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="配置 LLM 提供商、自定义模型与 API Key。Key 仅保存在本地。"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,16" />

                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgLayer1}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <!-- 提供商头部 + 删除 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource TextTertiary}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding BaseUrl}" FontSize="10.5"
                                                   Foreground="{StaticResource TextTertiary}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Content="删除提供商" Style="{StaticResource GhostButton}"
                                                FontSize="11" Padding="10,4"
                                                Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <TextBlock Text="API Key" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,4" />
                                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             Width="340" HorizontalAlignment="Left"
                                             FontSize="13" BorderBrush="{StaticResource BorderColor}" Padding="8,5" />
                                    <TextBlock Text="各厂商独立保存,留空则使用环境变量" FontSize="10.5"
                                               Foreground="{StaticResource TextTertiary}" Margin="0,4,0,10" />

                                    <!-- 模型列表 -->
                                    <TextBlock Text="模型" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,4,0,6" />
                                    <ItemsControl ItemsSource="{Binding Models}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgLayer3}" CornerRadius="6"
                                                        Padding="10,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                                            <Border Background="#E8F0FE" CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                                                    Visibility="{Binding Thinking, Converter={StaticResource BoolVisConv}}">
                                                                <TextBlock Text="thinking" FontSize="9.5" Foreground="#1A73E8" />
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="✕" FontSize="10" Padding="8,2"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="{StaticResource TextTertiary}"
                                                                Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" ToolTip="删除该模型" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 添加模型 -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="模型 ID（必填）" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding NewModelId, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" Style="{StaticResource InputBox}"
                                                     ToolTip="模型 ID,如 deepseek-chat / gpt-4o" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="显示名称（可选）" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" Style="{StaticResource InputBox}"
                                                     ToolTip="列表中的显示名称,如 我的模型" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Content="支持思考" IsChecked="{Binding NewModelThinking}"
                                                  VerticalAlignment="Bottom" Margin="12,0,0,6" FontSize="11"
                                                  Foreground="{StaticResource TextSecondary}"
                                                  ToolTip="勾选表示该模型支持 reasoning(思考)输出" />
                                        <Button Grid.Column="3" Content="添加模型" Style="{StaticResource PrimaryButton}" FontSize="11"
                                                Padding="12,5" Margin="12,0,0,0" VerticalAlignment="Bottom"
                                                Command="{Binding AddModelCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 从预设厂商一键添加 -->
                <Border Background="{StaticResource BgLayer1}" CornerRadius="10" Padding="14" Margin="0,4,0,0"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="＋ 从预设厂商添加（OpenAI 兼容）" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="一键加入主流大模型厂商及其常用模型,添加后可点击该厂商卡片,为其中的具体模型配置 API Key。"
                                   FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding KnownProviderOptions}" SelectedItem="{Binding SelectedKnownProvider, Mode=TwoWay}"
                                      DisplayMemberPath="Name" FontSize="12"
                                      BorderBrush="{StaticResource BorderColor}" Padding="8,5"
                                      ToolTip="选择一个大模型厂商,自动填充其接口地址与常见模型" />
                            <Button Grid.Column="1" Content="添加该厂商" Style="{StaticResource PrimaryButton}" FontSize="11"
                                    Padding="16,6" Margin="12,0,0,0"
                                    Command="{Binding AddKnownProviderCommand}" />
                        </Grid>
                        <TextBlock Text="提示：添加后仍需在对应厂商卡片中填写 API Key 并点击「保存并应用」。"
                                   FontSize="10.5" Foreground="{StaticResource TextTertiary}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 添加自定义提供商 -->
                <Border Background="{StaticResource BgLayer1}" CornerRadius="10" Padding="14" Margin="0,4,0,0"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="＋ 添加自定义提供商（OpenAI 兼容端点）" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="提供商名称（必填）" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding NewProviderName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Style="{StaticResource InputBox}"
                                         ToolTip="显示名称,如 我的中转站" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="唯一 ID（必填）" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding NewProviderId, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Style="{StaticResource InputBox}"
                                         ToolTip="内部标识,如 my-openai,不能与现有重复" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="API 端点（留空 = DeepSeek 官方）" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding NewProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Style="{StaticResource InputBox}"
                                         ToolTip="OpenAI 兼容基地址,如 https://api.openai.com/v1" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Text="API Key（留空 = 环境变量）" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding NewProviderApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Style="{StaticResource InputBox}"
                                         ToolTip="该提供商的密钥,仅保存在本地 settings.json" />
                            </StackPanel>
                            <Button Grid.Column="4" Content="添加" Style="{StaticResource PrimaryButton}" FontSize="11"
                                    Padding="16,6" Margin="12,17,0,0" VerticalAlignment="Bottom"
                                    Command="{Binding AddProviderCommand}" />
                        </Grid>
                        <TextBlock Text="提示：自定义端点需兼容 /v1/chat/completions（SSE 流式 + 工具调用）。"
                                   FontSize="10.5" Foreground="{StaticResource TextTertiary}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Presets ===== -->
            <StackPanel x:Name="PresetsPanel" Visibility="{Binding SelectedTab, Converter={StaticResource TabIsPresetsConv}, ConverterParameter=Presets}">
                <TextBlock Text="Agent 预设" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="选择 Agent 预设组合(对齐参考项目 agent-presets)。"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,16" />
                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgLayer1}" CornerRadius="10" Padding="14" Margin="0,0,0,10"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextTertiary}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- ===== Plugins ===== -->
            <StackPanel x:Name="PluginsPanel" Visibility="{Binding SelectedTab, Converter={StaticResource TabIsPluginsConv}, ConverterParameter=Plugins}">
                <TextBlock Text="已加载插件(当前预设组合行)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="同步自上游 deepseek-harness(226 个插件包)。已实现 = 有 C# 能力;框架级 = 由系统提示/循环处理;待实现 = 上游存在,本项目未移植。"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,16" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Plugins}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgLayer1}" CornerRadius="10" Padding="14" Margin="0,0,0,8"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessGreen}" Margin="0,0,12,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding Enabled, Converter={StaticResource BoolVisConv}}" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource WarnAmber}" Margin="0,0,12,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding Enabled, Converter={StaticResource BoolVisConv}, ConverterParameter=invert}" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <Border Background="{Binding CapabilityBadge}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding CapabilityLabel}" FontSize="9.5"
                                                           Foreground="{Binding CapabilityForeground}" />
                                            </Border>
                                            <Border Background="#FFF3E0" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    Visibility="{Binding RequiresApproval, Converter={StaticResource BoolVisConv}}">
                                                <TextBlock Text="需审批" FontSize="9.5" Foreground="#E65100" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== General ===== -->
            <StackPanel x:Name="GeneralPanel" Visibility="{Binding SelectedTab, Converter={StaticResource TabIsGeneralConv}, ConverterParameter=General}">
                <TextBlock Text="常规设置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="工作区与权限级别。"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,16" />

                <TextBlock Text="工作区目录" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <TextBox Text="{Binding Workspace, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                         Margin="0,6,0,16" />
                <TextBlock Text="运行目录下的命令与文件读写均在此目录内执行。" FontSize="10.5"
                           Foreground="{StaticResource TextTertiary}" Margin="0,-12,0,16" />

                <TextBlock Text="权限级别" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <ComboBox ItemsSource="{Binding Permissions}" SelectedItem="{Binding SelectedPermission, Mode=TwoWay}"
                          Width="300" Margin="0,6,0,16" />
                <TextBlock Text="read-only: 只读文件与搜索;workspace-write: 可写工作区与运行命令;danger-full-access: 任意路径与命令。"
                           FontSize="10.5" Foreground="{StaticResource TextTertiary}" Margin="0,-12,0,16" TextWrapping="Wrap" />

                <TextBlock Text="数据目录" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="{Binding DataDirLabel}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,4" />
            </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="{StaticResource BgLayer1}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="Apply_Click" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
