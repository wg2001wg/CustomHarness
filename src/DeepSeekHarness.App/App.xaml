<Application x:Class="DeepSeekHarness.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DeepSeekHarness.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ============ 转换器 ============ -->
            <conv:MessageKindToAlignmentConverter x:Key="MsgAlignConv" />
            <conv:MessageKindToBackgroundConverter x:Key="MsgBgConv" />
            <conv:MessageKindToForegroundConverter x:Key="MsgFgConv" />
            <conv:ToolStatusToBrushConverter x:Key="ToolStatusBrushConv" />
            <conv:ToolStatusToLabelConverter x:Key="ToolStatusLabelConv" />
            <conv:InverseBooleanConverter x:Key="InverseBoolConv" />
            <conv:StringToVisibilityConverter x:Key="StrVisConv" />
            <conv:BoolToVisibilityConverter x:Key="BoolVisConv" />
            <conv:KindIsUserConverter x:Key="KindIsUserConv" />
            <conv:KindIsAssistantConverter x:Key="KindIsAssistantConv" />
            <conv:KindIsSystemConverter x:Key="KindIsSystemConv" />
            <conv:SidebarWidthConverter x:Key="SidebarWidthConv" />
            <conv:TabVisibilityConverter x:Key="TabIsModelsConv" />
            <conv:TabVisibilityConverter x:Key="TabIsPresetsConv" />
            <conv:TabVisibilityConverter x:Key="TabIsPluginsConv" />
            <conv:TabVisibilityConverter x:Key="TabIsGeneralConv" />

            <!-- ============ 调色板(对齐 DeepSeek Harness 设计令牌) ============ -->
            <SolidColorBrush x:Key="DeepSeekBlue" Color="#4176E6" />
            <SolidColorBrush x:Key="DeepSeekBlueHover" Color="#5A8AEE" />
            <SolidColorBrush x:Key="BgLayer1" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BgLayer2" Color="#F6F7FA" />
            <SolidColorBrush x:Key="BgLayer3" Color="#EDEFF4" />
            <SolidColorBrush x:Key="BorderColor" Color="#E3E6EC" />
            <SolidColorBrush x:Key="TextPrimary" Color="#23272F" />
            <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
            <SolidColorBrush x:Key="TextTertiary" Color="#9CA3AF" />
            <SolidColorBrush x:Key="SuccessGreen" Color="#34A853" />
            <SolidColorBrush x:Key="ErrorRed" Color="#D93025" />
            <SolidColorBrush x:Key="WarnAmber" Color="#F9A825" />
            <SolidColorBrush x:Key="CodeBg" Color="#F5F6FA" />

            <!-- ============ 全局控件样式 ============ -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="Background" Value="{StaticResource DeepSeekBlue}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource DeepSeekBlueHover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" x:Key="GhostButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgLayer3}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox" x:Key="InputBox">
                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                <Setter Property="Background" Value="{StaticResource BgLayer1}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontSize" Value="13.5" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <Style TargetType="ListBox" x:Key="NavList">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgLayer3}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E3ECFD" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
